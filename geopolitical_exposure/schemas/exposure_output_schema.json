{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario exposure extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["firm_id", "document_id", "scenario_id", "exposures", "no_supported_exposure"],
  "properties": {
    "firm_id": {"type": "string"},
    "document_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "no_supported_exposure": {"type": "boolean"},
    "exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "direction", "score", "confidence", "evidence", "evidence_start", "evidence_end", "reasoning_summary"],
        "properties": {
          "channel": {"type": "string"},
          "direction": {"type": "string", "enum": ["positive", "negative", "ambiguous", "none"]},
          "score": {"type": "number", "minimum": -1, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "string", "maxLength": 1000},
          "evidence_start": {"type": "integer", "minimum": 0},
          "evidence_end": {"type": "integer", "minimum": 0},
          "reasoning_summary": {"type": ["string", "null"]}
        }
      }
    }
  }
}
