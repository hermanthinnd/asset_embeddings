{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "firm_id": {"type": "string"},
    "document_id": {"type": "string"},
    "document_type": {"type": "string", "enum": ["10-K", "10-Q"]},
    "available_date": {"type": "string"},
    "has_exposure_evidence": {"type": "boolean"},
    "document_summary": {"type": "string"},
    "exposures": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mechanism": {
            "type": "string",
            "enum": [
              "upstream_extraction", "refining_processing", "recycling_recovery",
              "equipment_infrastructure", "battery_storage", "transport_electrification",
              "electronics_semiconductors", "energy_power_systems", "substitution_efficiency",
              "geographic_supply_dependence", "policy_funding_procurement", "commodity_input_cost"
            ]
          },
          "direction": {"type": "string", "enum": ["positive", "negative", "mixed", "unclear"]},
          "directness": {"type": "string", "enum": ["direct", "indirect"]},
          "minerals": {"type": "array", "items": {"type": "string"}},
          "exposure_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_quote": {"type": "string"},
          "reasoning_summary": {"type": "string"}
        },
        "required": [
          "mechanism", "direction", "directness", "minerals", "exposure_strength",
          "confidence", "evidence_quote", "reasoning_summary"
        ]
      }
    }
  },
  "required": [
    "firm_id", "document_id", "document_type", "available_date",
    "has_exposure_evidence", "document_summary", "exposures"
  ]
}
