{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "firm_id": {"type": "string"},
    "document_id": {"type": "string"},
    "document_type": {"type": "string", "enum": ["10-K", "10-Q"]},
    "available_date": {"type": "string"},
    "has_exposure_evidence": {"type": "boolean"},
    "abstention_reason": {"type": "string", "enum": ["none", "no_relevant_text", "keyword_only", "incidental_only", "insufficient_materiality", "unsupported_causal_link"]},
    "document_assessment": {"type": "string"},
    "exposures": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "mechanism": {"type": "string", "enum": ["upstream_extraction", "refining_processing", "recycling_recovery", "equipment_infrastructure", "battery_storage", "transport_electrification", "electronics_semiconductors", "energy_power_systems", "substitution_efficiency", "geographic_supply_dependence", "policy_funding_procurement", "commodity_input_cost"]},
          "supply_chain_position": {"type": "string", "enum": ["upstream", "midstream", "downstream", "enabler", "consumer_input", "policy_financing", "unclear"]},
          "direction": {"type": "string", "enum": ["positive", "negative", "mixed", "unclear"]},
          "directness": {"type": "string", "enum": ["direct", "first_order_indirect", "second_order_indirect"]},
          "materiality": {"type": "string", "enum": ["core", "meaningful", "incidental", "insufficient"]},
          "disclosure_status": {"type": "string", "enum": ["existing", "planned", "contingent", "hypothetical"]},
          "time_horizon": {"type": "string", "enum": ["near_term", "medium_term", "long_term", "unclear"]},
          "minerals": {"type": "array", "items": {"type": "string"}},
          "exposure_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "confidence_band": {"type": "string", "enum": ["low", "medium", "high"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_passage_id": {"type": "string"},
          "evidence_quote": {"type": "string"},
          "causal_chain": {"type": "string"},
          "counterevidence": {"type": "string"},
          "netting_note": {"type": "string"}
        },
        "required": ["mechanism", "supply_chain_position", "direction", "directness", "materiality", "disclosure_status", "time_horizon", "minerals", "exposure_strength", "confidence_band", "confidence", "evidence_passage_id", "evidence_quote", "causal_chain", "counterevidence", "netting_note"]
      }
    }
  },
  "required": ["firm_id", "document_id", "document_type", "available_date", "has_exposure_evidence", "abstention_reason", "document_assessment", "exposures"]
}
